{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
