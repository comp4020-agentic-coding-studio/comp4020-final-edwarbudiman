    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "ws": "^8.22.0"
  },
